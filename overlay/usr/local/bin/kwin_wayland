#!/usr/bin/env python3
"""Observe the packaged compositor without masking its death with wrapper retries."""
import json
import os
from pathlib import Path
import signal
import subprocess
import sys

args = sys.argv[1:]
if any(arg.startswith('--xwayland') for arg in args):
    raise SystemExit('Xwayland is not supported by this image')
state = os.environ.get('WOLF_PLASMA_SESSION_STATE')
if not state or '--wayland-fd' not in args:
    os.execv('/usr/bin/kwin_wayland', ['/usr/bin/kwin_wayland', *sys.argv[1:]])
directory = Path(state)
if (directory / 'compositor.json').exists():
    # The packaged wrapper can restart KWin. A lost streaming compositor instead
    # requires a fresh session, even when Plasma subsequently exits with status 0.
    raise SystemExit(1)
socket_name = args[args.index('--socket') + 1]
# Keep the socket FD handed to us by the packaged wrapper across this exec chain.
child = subprocess.Popen(['/usr/bin/kwin_wayland', *args], close_fds=False)
for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
    signal.signal(sig, lambda number, frame: child.send_signal(number))
temporary = directory / 'compositor.tmp'
temporary.write_text(json.dumps({'pid': child.pid, 'socket': socket_name}))
temporary.replace(directory / 'compositor.json')
status = child.wait()
exited = directory / 'compositor-exited.tmp'
exited.write_text(str(status))
exited.replace(directory / 'compositor-exited')
raise SystemExit(status if status >= 0 else 128 - status)
